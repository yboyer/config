{
  "name": "@yboyer/config",
  "version": "2.3.0",
  "description": "",
  "homepage": "https://github.com/yboyer/config",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/yboyer/config.git"
  },
  "license": "MIT",
  "files": [
    "biome.json",
    "biome-esm.json",
    "dist"
  ],
  "scripts": {
    "lint": "vp check",
    "check:biome": "biome check --config-path=biome.json --formatter-enabled=false --linter-enabled=false --assist-enabled=false --no-errors-on-unmatched biome.json && biome check --config-path=biome-esm.json --formatter-enabled=false --linter-enabled=false --assist-enabled=false --no-errors-on-unmatched biome-esm.json",
    "format": "vp fmt",
    "build": "vp pack"
  },
  "peerDependencies": {
    "@biomejs/biome": "^2.6.2",
    "vite-plus": "^1.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@tsconfig/node26": "26.0.1",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0",
    "vite-plus": "1.5.0"
  },
  "exports": {
    "./biome.json": "./biome.json",
    "./biome-esm.json": "./biome-esm.json",
    "./package.json": "./package.json",
    "./vite-plus": {
      "types": "./dist/vite-plus.d.mts",
      "import": "./dist/vite-plus.mjs",
      "require": "./dist/vite-plus.mjs"
    }
  },
  "peerDependenciesMeta": {
    "@biomejs/biome": {
      "optional": true
    },
    "vite-plus": {
      "optional": true
    }
  },
  "type": "module",
  "dependencies": {
    "eslint-plugin-perfectionist": "5.13.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0"
  }
}
